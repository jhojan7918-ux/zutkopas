                                    path: result.routes[0].legs[0].steps.flatMap(step => step.path).slice(0, 100),
                                    icons: [{
                                        icon: {
                                            path: google.maps.SymbolPath.FORWARD_CLOSED_ARROW,
                                            scale: 3,
                                            strokeColor: '#00d2d3',
                                            strokeOpacity: 1
                                        },
                                        offset: '0',
                                        repeat: '100px'
                                    }],
                                    strokeOpacity: 0,
                                    map: mapaZutko
                                });

                                // 🧠 Actualiza la ubicación base para la próxima comparación
                                ultimaUbicacionRuta = nuevaUbicacion;
                            } else {
                            }
                        });
                    }
                } else {
                    // Primera vez que se guarda la ubicación como referencia
                    ultimaUbicacionRuta = nuevaUbicacion;
                }

                if (!marcadorPasajero) {
                    marcadorPasajero = new google.maps.Marker({
                        position: nuevaUbicacion,
                        map: mapaZutko,
                        icon: crearIconoPasajero(rotacion),
                        title: "Tú (Pasajero)"
                    });
                } else {
                    const img = new Image();
                    img.src = "https://zutko.co/wp-content/uploads/Icon/IconoPa.png";

                    img.onload = function () {
