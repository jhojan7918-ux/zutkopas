	function mostrarAlertaGlobal(mensaje, opciones = {}) {
  const modal = document.getElementById("modal-global-alerta");
  const mensajeElemento = document.getElementById("mensaje-global");
  const botones = document.getElementById("botones-globales");

  mensajeElemento.textContent = mensaje;

  // Limpiar botones anteriores
  botones.innerHTML = "";

  // Si se pasan botones personalizados
  if (opciones.botones) {
    opciones.botones.forEach(({ texto, callback }) => {
      const btn = document.createElement("button");
      btn.textContent = texto;
      btn.onclick = () => {
        modal.style.display = "none";
        if (callback) callback();
      };
      botones.appendChild(btn);
    });
  } else {
    // Botón por defecto: solo cerrar
    const btn = document.createElement("button");
    btn.textContent = "Aceptar";
    btn.onclick = () => modal.style.display = "none";
    botones.appendChild(btn);
  }

  modal.style.display = "flex";
}
	function mostrarAlertaGlobalAsync(mensaje) {
  return new Promise(resolve => {
    const modal = document.getElementById("modal-global-alerta");
