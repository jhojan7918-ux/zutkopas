function mostrarRadarEnOrigen(mapa, posicion) {
  const radarDiv = document.createElement("div");
  radarDiv.className = "radar-effect";

  const overlayRadar = new google.maps.OverlayView();
  overlayRadar.onAdd = function () {
    this.getPanes().overlayLayer.appendChild(radarDiv);
  };

  overlayRadar.draw = function () {
    const projection = this.getProjection();
    const posPixel = projection.fromLatLngToDivPixel(posicion);
    radarDiv.style.left = posPixel.x + "px";
    radarDiv.style.top = posPixel.y + "px";
  };

  overlayRadar.onRemove = function () {
    radarDiv.remove();
  };

  overlayRadar.setMap(mapa);

  // Guardamos referencia global para poder eliminarlo después
  window.radarOverlayOrigen = overlayRadar;
}
