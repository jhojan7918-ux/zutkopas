async function verificarExistenciaUsuario(telefono, correo) {
    const formData = new FormData();
    formData.append("action", "verificar_existencia_usuario");
    formData.append("telefono", telefono);
    formData.append("email", correo);
    try {
        const res = await fetch("/wp-admin/admin-ajax.php", {
            method: "POST",
            body: formData
        });
        return await res.json();
    } catch (err) {
        return { error: "error" };
    }
}

