(function(){
  const inputs = Array.from(document.querySelectorAll(".codigo-digit"));
  if (!inputs.length) return;

  // Limpia y enfoca el primero al abrir el modal
  window.resetCodigoInputs = function(){
    inputs.forEach(i => i.value = "");
    if (inputs[0]) inputs[0].focus();
  };

  // Aceptar solo dígitos y avanzar automático
  inputs.forEach((inp, idx) => {
    inp.setAttribute("inputmode", "numeric");
    inp.setAttribute("autocomplete", "one-time-code"); // hint para móviles

    inp.addEventListener("input", function(e){
      // Mantener solo un dígito numérico
      this.value = this.value.replace(/\D/g, "").slice(0,1);
      if (this.value && idx < inputs.length - 1) {
        inputs[idx + 1].focus();
        inputs[idx + 1].select();
      }
    });

    // Navegación: Backspace retrocede, flechas izquierda/derecha
    inp.addEventListener("keydown", function(e){
      if (e.key === "Backspace" && !this.value && idx > 0) {
        inputs[idx - 1].focus();
        inputs[idx - 1].value = "";
      }
      if (e.key === "ArrowLeft" && idx > 0) {
        inputs[idx - 1].focus();
        inputs[idx - 1].select();
        e.preventDefault();
      }
      if (e.key === "ArrowRight" && idx < inputs.length - 1) {
        inputs[idx + 1].focus();
        inputs[idx + 1].select();
        e.preventDefault();
      }
    });
  });

  // Pegar los 4 dígitos en cualquiera de los inputs
  const contenedor = inputs[0].parentElement || document;
  contenedor.addEventListener("paste", function(e){
    const pasted = (e.clipboardData || window.clipboardData).getData("text") || "";
    const nums = pasted.replace(/\D/g, "").slice(0, inputs.length);
    if (!nums) return;
    e.preventDefault();
    inputs.forEach((inp, i) => { inp.value = nums[i] || ""; });
    // Si se llenó todo, enfoca el botón "Verificar"
    const allFilled = inputs.every(i => i.value.length === 1);
    if (allFilled) {
      const btn = document.getElementById("verificar-codigo");
      if (btn) btn.focus();
    } else {
      // Si no, enfoca el primero vacío
      const next = inputs.find(i => !i.value);
      if (next) next.focus();
    }
  });

  // Si abres el modal de verificación, resetea y enfoca
  const modal = document.getElementById("modal-verificacion");
  if (modal) {
    const obs = new MutationObserver(() => {
      if (getComputedStyle(modal).display !== "none") resetCodigoInputs();
    });
    obs.observe(modal, { attributes: true, attributeFilter: ["style", "class"] });
  }
})();
	
