    };
}
	
	

function calcularRotacion(origen, destino) {
    const dy = destino.lat - origen.lat;
    const dx = destino.lng - origen.lng;
    const theta = Math.atan2(dy, dx);
    return (theta * 180) / Math.PI;
}

