function iniciarTemporizador() {
    tiempoRestante = 180;
    document.getElementById("contador").textContent = tiempoRestante;
    document.getElementById("reenviar-codigo").disabled = true;
    intervalo = setInterval(() => {
        tiempoRestante--;
