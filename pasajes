function crearIconoPasajero(rotacion) {
    const canvas = document.createElement("canvas");
    canvas.width = 60;
    canvas.height = 60;
    const ctx = canvas.getContext("2d");

    const img = new Image();
    img.src = "https://zutko.co/wp-content/uploads/Icon/IconoPa.png";

    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.save();
    ctx.translate(canvas.width / 2, canvas.height / 2);
    ctx.rotate((rotacion * Math.PI) / 180);
    ctx.drawImage(img, -20, -20, 40, 40);
    ctx.restore();

    return {
        url: canvas.toDataURL(),
        scaledSize: new google.maps.Size(30, 30), // Tamaño reducido
        anchor: new google.maps.Point(15, 15)
    };
}

function iniciarGeolocalizacion() {
    if (navigator.geolocation) {
        navigator.geolocation.watchPosition(
            function(position) {
                const lat = position.coords.latitude;
                const lng = position.coords.longitude;
                const nuevaUbicacion = { lat, lng };

                let rotacion = 0;
                if (ultimaUbicacionPasajero) {
                    rotacion = calcularRotacion(ultimaUbicacionPasajero, nuevaUbicacion);
                }
                ultimaUbicacionPasajero = nuevaUbicacion;
				
				// 🔁 Verificamos si el pasajero se movió más de 50 metros para recalcular ruta
                if (ultimaUbicacionRuta) {
                    const distancia = calcularDistancia(
                        ultimaUbicacionRuta.lat, ultimaUbicacionRuta.lng,
                        nuevaUbicacion.lat, nuevaUbicacion.lng
                    );

                    if (distancia > 50) {
                        const destino = { lat: destinoLat, lng: destinoLng };

                        directionsService.route({
                            origin: nuevaUbicacion,
                            destination: destino,
                            travelMode: google.maps.TravelMode.DRIVING
                        }, (result, status) => {
                            if (status === "OK") {
